# ─────────────────────────────────────────────────────────────────────────
# Glaze — PRODUCTION environment. Copy to .env ON THE SERVER and fill in.
#
#   cp .env.example .env && nano .env
#
# This one file is read twice: by docker compose for ${...} substitution in
# docker-compose.yml, and by the api container as its environment, which is
# where Django's settings.py picks it up.
#
# ⚠ .env is gitignored and must stay that way. It holds the secret key, the
# database password and the mail password. It lives on the server only —
# never commit it, never paste it into a chat or an issue.
#
# ⚠ NO `$` IN PASSWORDS. Compose interpolates `$VAR` inside .env values, so a
# password containing a dollar sign silently becomes something else. Either
# generate without one or escape it as `$$`. `openssl rand -base64 36 | tr -d
# '/+=$'` avoids the problem entirely.
# ─────────────────────────────────────────────────────────────────────────


# ── Domain ───────────────────────────────────────────────────────────────
# ⚠ www IS THE CANONICAL HOST for this codebase — it is hardcoded in
# client/index.html and defaulted in siteOrigin.js. Changing to the apex means
# changing those two, SITE_URL, VITE_SITE_URL and deploy/nginx/app.conf
# together. Pick one and 301 the other; both serving the same pages is one
# page competing with itself in the index.
DOMAIN=glazewindowsystems.com
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
LETSENCRYPT_EMAIL=info@glazewindowsystems.com

# bootstrap.conf for the very first boot (no certificate yet), then app.conf
# for good. See docs/DEPLOYMENT.md step 7.
NGINX_CONF=app.conf


# ── Django core ──────────────────────────────────────────────────────────
# Generate a NEW one for production — do not reuse the development key:
#
#   docker run --rm python:3.14-slim python -c \
#     "import secrets,string; a=string.ascii_letters+string.digits+'!@#%^&*(-_=+)'; \
#      print(''.join(secrets.choice(a) for _ in range(50)))"
#
# ⚠ Plain `docker run`, not `docker compose run api` — the api container's
# entrypoint waits for PostgreSQL and runs migrations before it would execute
# anything you asked for, and at this point neither exists yet.
#
# Rotating this logs everyone out and invalidates in-flight captchas.
SECRET_KEY=replace-me-with-a-generated-key

# ⚠ Never True in production. It would expose settings, SQL and a full
# traceback on any error, and it silently switches email to the console
# backend so enquiries would stop being delivered.
DEBUG=False

# Checked against the Host header nginx forwards. The healthz check hits the
# container by IP, hence 127.0.0.1.
ALLOWED_HOSTS=glazewindowsystems.com,www.glazewindowsystems.com,127.0.0.1,localhost


# ── Database ─────────────────────────────────────────────────────────────
# DB_HOST is forced to `db` by docker-compose.yml; the value here is only for
# running manage.py against the stack from outside it.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=glaze_db
DB_USER=glaze
DB_PASSWORD=replace-me-with-a-long-random-password
DB_HOST=db
DB_PORT=5432


# ── Origins ──────────────────────────────────────────────────────────────
# ⚠ settings.py sets CSRF_TRUSTED_ORIGINS = CORS_ALLOWED_ORIGINS. So even
# though the SPA and API share an origin in production and CORS is barely
# involved, THE PUBLIC ORIGIN MUST BE LISTED HERE — otherwise every POST from
# the Studio fails CSRF verification and logging in is impossible.
CORS_ALLOWED_ORIGINS=https://www.glazewindowsystems.com,https://glazewindowsystems.com

# The canonical origin for robots.txt, llms.txt, sitemap.xml and the JSON-LD.
# Must be set here: behind a proxy request.get_host() is the container's
# internal name, and a sitemap of http://172.18.0.4:8000/… lists URLs that do
# not exist. No trailing slash.
SITE_URL=https://www.glazewindowsystems.com

# Stamped on the sitemap's static routes, which have no updated_at. A DATE.
# Bump it when page content meaningfully changes — not on every deploy, or
# lastmod stops meaning anything to a crawler.
SITE_LAST_DEPLOYED=2026-08-04


# ── Auth cookies ─────────────────────────────────────────────────────────
AUTH_COOKIE_ACCESS_NAME=glaze_access
AUTH_COOKIE_REFRESH_NAME=glaze_refresh
# HTTPS-only. A Secure cookie is dropped over plain http, which is correct.
AUTH_COOKIE_SECURE=True
# Lax is right because the SPA and API share a site here. Cross-site would
# need None, which in turn requires Secure.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_ENFORCE_CSRF=True
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7


# ── Login hardening ──────────────────────────────────────────────────────
ADMIN_MAX_ACCOUNT_FAILURES=5
ADMIN_MAX_IP_FAILURES=20
ADMIN_LOCKOUT_SECONDS=300
ADMIN_LOCKOUT_MAX_SECONDS=86400
ADMIN_FAILURE_WINDOW_SECONDS=900

# ⚠ True ONLY because nginx now sits in front and OVERWRITES X-Forwarded-For
# with the real peer address (deploy/nginx/snippets/proxy.conf). Behind that
# proxy this is what makes the per-IP lockout see real visitors instead of the
# container's gateway address — every request would otherwise appear to come
# from 172.18.0.1 and one attacker would lock out everyone.
# Turn it back off if nginx is ever removed from the path.
ADMIN_TRUST_FORWARDED_FOR=True


# ── Captcha ──────────────────────────────────────────────────────────────
# 'internal' is self-hosted, needs no third-party account and sends no visitor
# data anywhere. Change only if you want a hosted provider.
CAPTCHA_PROVIDER=internal
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=
CAPTCHA_TTL_SECONDS=300
CAPTCHA_LENGTH=5


# ── Rate limits (per IP) ─────────────────────────────────────────────────
THROTTLE_LOGIN=10/min
THROTTLE_CAPTCHA=30/min
THROTTLE_ENQUIRY=5/min
THROTTLE_TRACK=120/min
THROTTLE_COMMENT=5/min
THROTTLE_CHAT=20/min


# ── Email ────────────────────────────────────────────────────────────────
# Transport only. WHO receives an enquiry — including the separate routing for
# product, contact and general enquiries — is edited in the Studio under
# Settings › Contact settings, because it changes with the team rather than
# with the deployment.
#
# ⚠ Gmail: EMAIL_HOST_PASSWORD is an APP PASSWORD (16 characters, generated at
# myaccount.google.com/apppasswords with 2-Step Verification on). The account
# password has not worked for SMTP since 2022.
#
# ⚠ ROTATE THE APP PASSWORD BEFORE LAUNCH if the one in development was ever
# pasted into a chat, an issue or a screenshot. Revoking and regenerating
# takes a minute and there is no way to tell whether a leaked one has been used.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@glazewindowsystems.com
EMAIL_HOST_PASSWORD=replace-with-the-16-character-app-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15
# ⚠ Gmail rewrites a From address it does not own, so this must be
# EMAIL_HOST_USER or one of its verified aliases.
DEFAULT_FROM_EMAIL=Glaze Window Systems <info@glazewindowsystems.com>


# ── Uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=5242880


# ── Site assistant (RAG chatbot) ─────────────────────────────────────────
# SERVER-SIDE ONLY. Never give these a VITE_ prefix — that ships the key to
# the browser, where anyone can read it out of the network tab and spend it.
# Leave blank and the assistant falls back to extractive answers rather than
# failing.
CHAT_PROVIDER_CHAIN=groq,cerebras
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b


# ── First-run admin ──────────────────────────────────────────────────────
# Read by `manage.py bootstrap_admin`, so the password never appears in a
# shell command and therefore never in shell history. Run it once, then blank
# BOTH LINES and leave them blank — the account exists in the database from
# then on, and there is no reason for a live password to sit in a file.
# The password is validated against AUTH_PASSWORD_VALIDATORS, so a weak one
# is rejected rather than quietly accepted.
GLAZE_ADMIN_EMAIL=
GLAZE_ADMIN_PASSWORD=


# ── Frontend build args ──────────────────────────────────────────────────
# ⚠ Baked into the JavaScript at build time. Changing one requires
# `docker compose build web`; a restart will not do it.
VITE_API_URL=/api/v1
VITE_SITE_URL=https://www.glazewindowsystems.com
# Set to true on a staging deployment so it cannot be indexed. Blank for live.
VITE_NOINDEX=


# ── Gunicorn ─────────────────────────────────────────────────────────────
# Each worker is a full copy of Django, roughly 120 MB. 3 suits a 2 GB box;
# 2×cores+1 is the usual formula if the VPS is larger.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
