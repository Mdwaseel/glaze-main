# ⚠ THE CRLF TRAP. This repository is developed on Windows and runs on Linux
# in a container. Git's autocrlf can hand a checkout LF→CRLF conversions, and
# a shell script with CRLF line endings fails at the shebang: the kernel looks
# for an interpreter literally named "/bin/sh\r" and reports
#
#     exec /usr/local/bin/entrypoint.sh: no such file or directory
#
# — naming a file that is plainly there. Pinning these to LF removes the whole
# class of problem regardless of anyone's local git configuration.

*.sh            text eol=lf
entrypoint.sh   text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
.env.example    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Never diff or line-ending-convert these. Git usually detects binaries
# correctly; saying so explicitly also keeps them out of `git diff` output.
*.mp4   binary
*.webm  binary
*.mov   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary

# Generated — collapse it in pull request diffs rather than reviewing 20k
# lines of resolved dependency tree.
package-lock.json linguist-generated=true -diff
