# Copy to .env.local (gitignored) to override. Every value here is the
# default already baked into the code, so a plain `npm run dev` works with
# no .env at all.

# Base URL of the Django API, including the version prefix.
#   local dev    http://localhost:8000/api/v1
#   same-origin  /api/v1
# Used by services/api.js for every request, by services/analytics.js for the
# tracking beacon, and by the contact form controller for enquiry submission.
VITE_API_URL=http://localhost:8000/api/v1
