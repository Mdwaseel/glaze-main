# Template for server/glaze/.env — this file IS committed, .env is NOT.
#
# Setup:
#   cp .env.example .env
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   ...then paste the result as SECRET_KEY below.

# --- Core ---
# Signs sessions, the JWTs, the captcha challenges and the analytics visitor
# salt. Keep it secret; changing it logs everyone out and invalidates every
# in-flight captcha.
SECRET_KEY=replace-me-with-a-generated-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# Driven by psycopg 3; the backend string is the same as for psycopg2.
# Create the database and role first:
#   psql -U postgres -c "CREATE DATABASE glaze_db;"
#   psql -U postgres -c "CREATE USER glaze WITH PASSWORD 'change-me';"
#   psql -U postgres -c "GRANT ALL PRIVILEGES ON DATABASE glaze_db TO glaze;"
#   psql -U postgres -d glaze_db -c "GRANT ALL ON SCHEMA public TO glaze;"
# (the last line is required on PostgreSQL 15+, where CREATE on the public
#  schema is no longer granted to PUBLIC by default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=glaze_db
DB_USER=glaze
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Auth cookies ---
AUTH_COOKIE_ACCESS_NAME=glaze_access
AUTH_COOKIE_REFRESH_NAME=glaze_refresh
# Leave blank to follow DEBUG (secure in production, insecure locally).
AUTH_COOKIE_SECURE=
# Lax when the SPA and API share a site; None (+ SECURE=True) when cross-site.
AUTH_COOKIE_SAMESITE=Lax
# Defaults to True. The SPA sends X-CSRFToken on every unsafe request, so
# there is no reason to turn this off.
AUTH_COOKIE_ENFORCE_CSRF=True

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Admin login hardening ---
# Failed tries against ONE account before it locks.
ADMIN_MAX_ACCOUNT_FAILURES=5
# Failed tries from ONE IP across ANY account — catches password spraying.
ADMIN_MAX_IP_FAILURES=20
# First lockout in seconds; doubles on each consecutive lockout up to the max.
ADMIN_LOCKOUT_SECONDS=300
ADMIN_LOCKOUT_MAX_SECONDS=86400
# Rolling window over which failures accumulate.
ADMIN_FAILURE_WINDOW_SECONDS=900
# Turn on ONLY when a reverse proxy you control overwrites X-Forwarded-For.
# With no such proxy a client can forge the header and walk past the per-IP
# lockout by inventing a new address on every request.
ADMIN_TRUST_FORWARDED_FOR=False

# --- Captcha ---
# internal   self-hosted, HMAC-signed, no third-party account, works offline
# recaptcha | hcaptcha | turnstile   need CAPTCHA_SECRET_KEY + CAPTCHA_SITE_KEY
CAPTCHA_PROVIDER=internal
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=
CAPTCHA_TTL_SECONDS=300
CAPTCHA_LENGTH=5

# --- Rate limits (per IP) ---
THROTTLE_LOGIN=10/min
THROTTLE_CAPTCHA=30/min
THROTTLE_ENQUIRY=5/min
THROTTLE_TRACK=120/min
THROTTLE_COMMENT=5/min

# --- Email ---
# Enquiry RECIPIENTS — including the per-enquiry-type routing — the subject
# prefix and the auto-reply body are NOT here. They are edited in the admin
# panel (Settings > Contact settings), because they change with who is on the
# team rather than with the deployment. Only the transport belongs here.
#
# Leave EMAIL_BACKEND blank to print emails to the console while DEBUG=True;
# set it explicitly to send for real from a development machine.
#
# GMAIL: EMAIL_HOST_PASSWORD must be an APP PASSWORD (16 characters, shown in
# four groups), generated at myaccount.google.com/apppasswords with 2-Step
# Verification enabled. The account password has not worked for SMTP since
# 2022. Gmail also rewrites a From address it does not own, so
# DEFAULT_FROM_EMAIL has to be EMAIL_HOST_USER or a verified alias of it.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Seconds. Without it a hung relay holds the request thread open indefinitely,
# and enquiry submission is a request a visitor is waiting on.
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Glaze Window Systems <info@glazewindowsystems.com>

# --- Uploads ---
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Site assistant (RAG chatbot) ---
# SERVER-SIDE ONLY — never expose these to the browser with a VITE_ prefix.
# Providers are tried in order; the first that answers wins. If none do, the
# assistant falls back to extractive answers rather than failing.
CHAT_PROVIDER_CHAIN=groq,cerebras
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

